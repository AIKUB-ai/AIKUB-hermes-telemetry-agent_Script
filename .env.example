# Only URL + the bot telemetry token are required for the new Vault-backed workflow.
# Never commit real values.
AIKUB_TELEMETRY_BASE_URL=https://aikubtelemetry-production.up.railway.app
AIKUB_TELEMETRY_BOTOPS_TOKEN=replace-with-this-bot-token-from-vault

# Optional compatibility/identity fields. Not required by AIKUB_Telemetry auth anymore.
# AIKUB_TELEMETRY_API_KEY is still accepted by the scripts as a legacy alias for AIKUB_TELEMETRY_BOTOPS_TOKEN.
# AIKUB_TELEMETRY_API_KEY=replace-with-this-bot-token-from-vault
# AIKUB_TELEMETRY_BOT_ID=your-bot-slug
# AIKUB_TELEMETRY_SOURCE=hermes
