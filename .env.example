# Only URL + the bot telemetry token are required for the new Vault-backed workflow.
# Never commit real values.
AIKUB_TELEMETRY_BASE_URL=https://aikubtelemetry-production.up.railway.app
AIKUB_TELEMETRY_BOTOPS_TOKEN=replace-with-this-bot-token-from-vault

# Optional compatibility/identity fields. Not required by AIKUB_Telemetry auth anymore.
# AIKUB_TELEMETRY_API_KEY is still accepted by the scripts as a legacy alias for AIKUB_TELEMETRY_BOTOPS_TOKEN.
# AIKUB_TELEMETRY_API_KEY=replace-with-this-bot-token-from-vault
# AIKUB_TELEMETRY_BOT_ID=your-bot-slug
# AIKUB_TELEMETRY_SOURCE=hermes

# Optional: VERIFIED timezone of the Hermes logger that wrote agent.log, not
# the telemetry cron, host location or Hermes scheduling/display timezone.
# IANA name; requires system tzdata. Leave unset if unknown (timestamps stay null).
# Explicit Z / numeric offsets in individual log lines always take precedence.
# AIKUB_LOG_TIMEZONE=UTC
# AIKUB_LOG_TIMEZONE=America/Toronto

# New cron installations only: light every 2h + sessions daily; existing cron
# schedules/commands/locks are never rewritten. Stable slot is hashed from
# hostname + HERMES_HOME by default. Set distinct slots per bot for guaranteed spacing.
# AIKUB_TELEMETRY_CRON_SEED=unique-bot-name
# AIKUB_TELEMETRY_CRON_SLOT=0
# Slot 0..29, step 3 or 4 minutes (default 4); daily sessions start at 03:00 + offset.
# AIKUB_TELEMETRY_CRON_STEP_MINUTES=4
